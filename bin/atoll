#!/bin/bash

# Atoll for Omarchy: the `atoll` command.
#
# Upstream Ambxst ships a Go binary that runs its own Quickshell and daemon.
# Here Atoll lives inside Omarchy's shell (the `atoll.bar` plugin), so this
# forwards the everyday subcommands to it over Omarchy's IPC and to Omarchy's
# own commands. Keybinds written for upstream (`atoll run launcher`, ...)
# keep working unchanged.

PLUGIN_ID="atoll.bar"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
REPO_URL="https://github.com/AyushKr2003/Ambxst.git"

usage() {
  cat <<'EOF'
Usage: atoll <command> [args]

  run <action>          Open an Atoll surface: launcher, dashboard, clipboard,
                        emoji, notes, tmux, wallpapers, assistant, overview,
                        powermenu, tools, config, screenshot, screenrecord,
                        lens, lockscreen, media-play-pause, media-next,
                        media-prev, brightness-up, brightness-down, ...
  toggle bar            Pin or unpin the bar
  lock                  Lock the screen (Omarchy's lock)
  reload                Restart Omarchy's shell, Atoll included
  brightness <+N|-N>    Step screen brightness (Atoll's OSD)
  wallpaper set <file>  Set the background (omarchy-theme-bg-set)
  preset load <name>    Load an Atoll preset
  enable                Make Atoll Omarchy's bar
  disable               Go back to Omarchy's own bar
  status                Show whether Atoll is installed and active
  update                Update Atoll from GitHub and reinstall it
  version               Print the Atoll version
EOF
}

ipc() {
  omarchy-shell atoll "$@"
}

case ${1:-} in
  run)
    [[ -n ${2:-} ]] || { usage >&2; exit 2; }
    ipc run "$2"
    ;;
  toggle)
    ipc toggle "${2:-bar}"
    ;;
  lock)
    omarchy-system-lock
    ;;
  reload | restart)
    omarchy-restart-shell
    ;;
  brightness)
    case ${2:-} in
      +* | up) ipc run brightness-up ;;
      -* | down) ipc run brightness-down ;;
      *) echo "Usage: atoll brightness <+N|-N>" >&2; exit 2 ;;
    esac
    ;;
  wallpaper)
    [[ ${2:-} == "set" && -n ${3:-} ]] || { echo "Usage: atoll wallpaper set <file>" >&2; exit 2; }
    omarchy-theme-bg-set "$3"
    ;;
  preset)
    [[ ${2:-} == "load" && -n ${3:-} ]] || { echo "Usage: atoll preset load <name>" >&2; exit 2; }
    ipc preset "$3"
    ;;
  enable)
    omarchy bar use "$PLUGIN_ID"
    ;;
  disable)
    omarchy bar reset
    ;;
  status)
    if [[ -d $PLUGIN_DIR ]]; then
      echo "installed: $PLUGIN_DIR"
    else
      echo "not installed"
    fi
    active=$(omarchy-shell shell listShellConfig 2>/dev/null | jq -r '.bar.id // "omarchy.bar"' 2>/dev/null)
    echo "active bar: ${active:-unknown}"
    ;;
  update)
    # Pull the latest Atoll and reinstall it, keeping earlier choices.
    src="${XDG_DATA_HOME:-$HOME/.local/share}/atoll/src"
    if [[ -d $src/.git ]]; then
      git -C "$src" pull --ff-only || exit 1
    else
      mkdir -p "$(dirname "$src")"
      git clone "$REPO_URL" "$src" || exit 1
    fi
    "$src/install.sh" --yes
    ;;
  version | -v | --version)
    ipc version 2>/dev/null || cat "$PLUGIN_DIR/version" 2>/dev/null
    ;;
  help | -h | --help | "")
    usage
    ;;
  *)
    echo "atoll: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
